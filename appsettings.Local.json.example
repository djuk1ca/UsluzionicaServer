{
  // ŠABLON za lokalne tajne.
  // Kopiraj u `appsettings.Local.json` i popuni pravim vrednostima.
  // `appsettings.Local.json` je gitignore-ovan; ovaj .example fajl je u git-u
  // da svako ko klonira repo zna šta mu je potrebno.
  //
  // Generisanje ključeva (PowerShell):
  //   Jwt:Secret            [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
  //   Encryption:MessageKey [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
  //
  // Encryption:MessageKey MORA biti tačno 32 bajta (AES-256) posle base64 dekodiranja,
  // inače aplikacija pada na startu sa jasnom porukom.

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=UsluzionicaDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "<base64, min 32 bajta>"
  },
  "Email": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 2525,
    "Username": "<mailtrap username>",
    "Password": "<mailtrap password>",
    "From": "noreply@usluzionica.rs"
  },
  "AdminSeed": {
    "Email": "admin@usluzionica.rs",
    "Password": "<jaka lozinka>"
  },
  "Encryption": {
    "MessageKey": "<base64, tačno 32 bajta>"
  }
}
