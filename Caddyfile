# ═══════════════════════════════════════════════════════════════════════════
# Reverse proxy ispred API-ja.
#
# ŠTA OVAJ FAJL REŠAVA
#
# API u kontejneru sluša na 8080, običnim HTTP-om, i vezan je za 127.0.0.1
# (vidi docker-compose.prod.yml). Telefon očekuje https://api.usluzionica.rs
# na portu 443, sa važećim sertifikatom. Između te dve tačke treba nešto što:
#
#   1. sluša na 443,
#   2. pribavlja i OBNAVLJA TLS sertifikat (Let's Encrypt važi 90 dana),
#   3. prosleđuje zahtev kontejneru.
#
# Caddy radi sva tri, i to sam — dovoljno je da domen bude naveden ispod i da
# port 80 bude otvoren. Zbog toga je izabran umesto nginx-a, gde bi uz njega
# išli i certbot i cron za obnavljanje.
# ═══════════════════════════════════════════════════════════════════════════

{
	# Adresa na koju Let's Encrypt šalje upozorenje pred istek sertifikata,
	# ako automatsko obnavljanje iz nekog razloga zakaže.
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# ── Sertifikat ─────────────────────────────────────────────────────────
	# Ne piše se ništa: Caddy sam traži sertifikat od Let's Encrypt-a pri prvom
	# pokretanju i obnavlja ga na ~60 dana. Zato je /data volumen OBAVEZAN —
	# bez njega se pri svakom restartu traži nov, a Let's Encrypt dozvoljava
	# 5 istih sertifikata nedeljno. Šesti restart znači nedelju dana bez HTTPS-a.

	# ── Bezbednosna zaglavlja ──────────────────────────────────────────────
	header {
		# Godinu dana obaveznog HTTPS-a. Kad browser jednom ovo vidi, odbija
		# da se na ovaj domen poveže preko HTTP-a čak i ako korisnik tako ukuca.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Bez ovoga browser sme da "nanjuši" tip sadržaja mimo deklarisanog.
		X-Content-Type-Options "nosniff"

		# API ne treba nikom u <iframe>-u.
		X-Frame-Options "DENY"

		Referrer-Policy "strict-origin-when-cross-origin"

		# Ne otkrivaj čime je serviran.
		-Server
	}

	# ── Kompresija ─────────────────────────────────────────────────────────
	# JSON se dobro sažima: /api/categories ~19 KB → ~3 KB sa gzip-om. Na
	# mobilnim podacima to je razlika koja se oseti pri prvom pokretanju.
	# zstd za klijente koji ga traže, gzip za sve ostale.
	#
	# BEZ /hubs. WebSocket ionako ne bi bio diran, ali SignalR ume da padne na
	# Server-Sent Events — a kompresija zadržava takav tok u baferu, pa poruke
	# i obaveštenja ne bi stizali odmah nego u paketima.
	@kompresija not path /hubs/*
	encode @kompresija zstd gzip

	# ── Stare pozivnice ────────────────────────────────────────────────────
	# Do Marketing P0 aplikacija je delila api.usluzionica.rs/register?ref=KOD,
	# a ta stranica na API-ju nikad nije postojala (404). Linkovi su već poslati
	# porukama i ne mogu se povući — zato se preusmeravaju na pravu stranicu
	# pozivnice na sajtu. Host je fiksan, pa ovo nije otvoren redirect.
	@staraPozivnica {
		path /register
		query ref=*
	}
	redir @staraPozivnica https://{$APP_DOMAIN}/pozivnica/{query.ref} permanent

	# ── SignalR ────────────────────────────────────────────────────────────
	# Chat ide preko WebSocket-a. Caddy prosleđuje Upgrade zaglavlja sam, ali
	# podrazumevani timeout od nekoliko sekundi bi rušio žive konekcije, pa se
	# za /hubs ne postavlja gornja granica trajanja.
	@hubs path /hubs/*
	reverse_proxy @hubs api:8080 {
		flush_interval -1
	}

	# ── Sve ostalo ─────────────────────────────────────────────────────────
	# Ime `api` je ime servisa iz compose-a; Docker ga razrešava u internoj
	# mreži. Port 8080 je onaj iz Dockerfile-a (ASPNETCORE_HTTP_PORTS).
	reverse_proxy api:8080 {
		# Caddy SAM postavlja X-Forwarded-For i X-Forwarded-Proto — to je ono
		# što aplikacija zapravo čita kroz UseForwardedHeaders (Program.cs).
		# Bez te dve strane bi svaki zahtev izgledao kao da dolazi sa adrese
		# Caddy-ja, pa bi rate limiting brojao sve korisnike kao jednog.
		#
		# X-Real-IP nije obavezan, ali ga mnogi alati za analizu logova
		# očekuju, a ništa ne košta.
		header_up X-Real-IP {remote_host}
	}

	# ── Logovanje ──────────────────────────────────────────────────────────
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# ═══════════════════════════════════════════════════════════════════════════
# usluzionica.rs — marketinški sajt i pravne stranice
#
# Dopisati na KRAJ postojećeg Caddyfile-a, ispod bloka za {$API_DOMAIN}.
# Caddy sam traži sertifikat za nov domen — ne piše se ništa, isto kao za API.
# Volumen `caddy-data` mora da ostane; u njemu su sertifikati i ACME nalog.
# ═══════════════════════════════════════════════════════════════════════════

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	# ── www → apex ─────────────────────────────────────────────────────────
	# Jedna kanonska adresa. Dve adrese sa istim sadržajem cepaju SEO težinu,
	# a Google bira sam koju će prikazati.
	@www host www.{$APP_DOMAIN}
	redir @www https://{$APP_DOMAIN}{uri} permanent

	# ── Bezbednosna zaglavlja ──────────────────────────────────────────────
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"

		# CSP `default-src 'self'` prolazi samo zato što su fontovi i (kasnije)
		# Three.js lokalni. Da se povlače sa Google Fonts-a i cdnjs-a, ovde bi
		# morali da stoje njihovi hostovi — i izgubio bi se i deo zaštite i
		# argument iz politike privatnosti da podaci ne odlaze trećoj strani.
		#
		# img-src pušta api.usluzionica.rs zbog slika oglasa u Fazi 2.
		# 'unsafe-inline' za stilove je ustupak markupu prenetom iz dizajna,
		# koji stilove drži u atributima. Skinuti ga kad stilovi pređu u CSS.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://api.usluzionica.rs; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.usluzionica.rs; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		X-Frame-Options "DENY"
		-Server
	}

	# ── Kompresija ─────────────────────────────────────────────────────────
	# Statiku kompresuje MapStaticAssets (unapred, brotli), ali HTML stranicu
	# niko nije — išla je sirova, oko 90 KB. Caddy je sabija u pregovoru sa
	# pregledačem; zstd je prvi jer je brži, gzip je rezerva za starije.
	#
	# Bez matchera kao kod API-ja: ovde nema SignalR toka koji bi se zadržao
	# u baferu, sve je običan HTML i statika.
	encode zstd gzip

	# ── Keširanje ──────────────────────────────────────────────────────────
	# Statika ima otisak u imenu (MapStaticAssets), pa sme godinu dana.
	# HTML ne sme — tekst se menja, a stranica mora da se osveži isti dan.
	@fingerprinted path_regexp \.[0-9a-z]{8,}\.(css|js|woff2|png|svg|webp)$
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	@statika path *.woff2 *.webp *.png *.svg *.ico
	header @statika Cache-Control "public, max-age=604800"

	# ── Aplikacija ─────────────────────────────────────────────────────────
	# `site` je ime servisa iz compose-a; Docker ga razrešava u internoj mreži.
	reverse_proxy site:8080 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/site-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
