# Kopiraj u `.env` i popuni. `.env` je u .gitignore i .dockerignore.
# `docker compose` automatski čita `.env` iz istog foldera i menja ${VAR}.

# SQL Server traži: min 8 znakova, 3 od 4 kategorije (velika/mala/cifre/simboli)
MSSQL_SA_PASSWORD=

# Min 32 znaka (SecretsGuard to proverava i pada na startu ako nije)
JWT_SECRET=

# Base64 koji dekodira u TAČNO 32 bajta (AES-256)
# Poruke se šifruju AES-GCM ključem IZVEDENIM iz ovoga (k0) — ne menjati ga:
# promena bi učinila sve postojeće poruke nečitljivim.
ENCRYPTION_KEY=
#
# Rotacija ključa za poruke (samo kad zatreba, npr. posle curenja .env-a).
# NE menja se ENCRYPTION_KEY, nego se DODAJE nov ključ i proglašava tekućim;
# stari ostaje za čitanje. docker-compose.prod.yml oba reda već mapira, pa je
# rotacija: otkomentarisati, upisati ključ, `up -d api`.
# (generisanje na serveru: openssl rand -base64 32)
#ENCRYPTION_KEY_K1=
#ENCRYPTION_CURRENT_KEY_ID=k1

ADMIN_EMAIL=admin@usluzionica.rs
ADMIN_PASSWORD=

# Mora odgovarati adresi na kojoj je API dostupan — od ovoga zavise URL-ovi slika
APP_BASE_URL=http://localhost:8080
# ── Samo za produkciju (docker-compose.prod.yml) ────────────────────────────
# Na lokalnoj masini se ne koriste. Na serveru ih popunjava deploy.
# IMAGE_TAG upisuje CD workflow pri svakom deployu — ne dira se rucno.
#IMAGE_TAG=latest
#API_DOMAIN=api.usluzionica.rs
#APP_DOMAIN=usluzionica.rs
# Adresa na koju Let's Encrypt salje upozorenje ako obnavljanje sertifikata
# zakaze. Ne mora biti na ovom domenu.
#ACME_EMAIL=kontakt@usluzionica.rs

# ── SMTP (obavezno u produkciji) ─────────────────────────────────────────────
# SecretsGuard obara start ako EMAIL_HOST ili EMAIL_PASSWORD nedostaju kad je
# ASPNETCORE_ENVIRONMENT=Production. Bez ovoga niko ne moze da potvrdi nalog
# ni da resetuje lozinku.
#EMAIL_HOST=smtp.resend.com
#EMAIL_PORT=587
#EMAIL_USERNAME=resend
#EMAIL_PASSWORD=
#EMAIL_FROM=noreply@usluzionica.rs
#EMAIL_FROM_NAME=Usluzionica
# Odgovori na noreply idu ovde. Prazno = bez Reply-To zaglavlja.
#EMAIL_REPLY_TO=kontakt@usluzionica.rs

# ── PUSH NOTIFIKACIJE (FCM) ───────────────────────────────────────────────────
# Service account kljuc iz Firebase konzole:
#   Project settings -> Service accounts -> Generate new private key
#
# IDE CEO FAJL, najlakse kao base64 (prima se i sirov JSON u jednom redu).
#
# Base64 se preporucuje jer JSON sadrzi navodnike, kose crte i escape sekvence
# koje `.env` parseri ume da protumace, a kvar se vidi tek kad prva notifikacija
# ne stigne. PowerShell:
#
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("D:/putanja/do/kljuca.json"))
#
# Prazno = push iskljucen, aplikacija radi normalno (NoopPushSender).
# Ovo je TAJNA ravna lozinci — ko je ima moze slati notifikacije svim korisnicima.
#FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Prijava preko Facebook-a i Google-a ──────────────────────────────────────
# Prazno = taj provajder je iskljucen; prijava lozinkom radi normalno.
#
# Facebook: developers.facebook.com → aplikacija → App settings → Basic → App secret
# Google:   console.cloud.google.com → APIs & Services → Credentials → OAuth client
#           (tip "Web application", redirect https://<API_DOMAIN>/api/auth/google/callback)
#
# ClientId nije tajna, ali je u .env jer se razlikuje po okruzenju.
#FACEBOOK_APP_SECRET=
# true tek kad Meta pusti aplikaciju u Live (posle App Review-a); do tada dugme ne postoji.
#FACEBOOK_ENABLED=false
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ── Lista čekanja: datumi izlaska i mejl „stigli smo na App Store" ───────────
# Datum izlaska, yyyy-MM-dd, upisuje se NA DAN IZLASKA te platforme. Od tada za
# tu listu: bonus samo za upis pre tog dana i za nalog otvoren u roku od 60 dana.
# WAITLIST_IOS_LAUNCH_DATE je ujedno datum izlaska na iOS-u za mejl listi
# čekanja — dok je prazan (ili u budućnosti), mejl se ne može poslati.
#WAITLIST_ANDROID_LAUNCH_DATE=
#WAITLIST_IOS_LAUNCH_DATE=
# Pravi link iz App Store Connect-a (App Information → View on App Store).
# Prazno = pravo slanje mejla listi čekanja je odbijeno.
#APP_STORE_URL=
#GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=rs.usluzionica.app
# Tempo slanja: paket, pauza između paketa (s), najviše po pokretanju.
# Drži MAX ispod dnevnog limita SMTP provajdera — verifikacioni mejlovi troše isti.
#WAITLIST_EMAIL_BATCH_SIZE=20
#WAITLIST_EMAIL_PAUSE_SECONDS=60
#WAITLIST_EMAIL_MAX_PER_RUN=80
