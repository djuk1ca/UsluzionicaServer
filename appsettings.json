{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ── TAJNE ────────────────────────────────────────────────────────────────
  // Vrednosti ispod su NAMERNO prazne. Nikad ne upisuj prave tajne u ovaj
  // fajl — on je u git-u. Popuni ih na jedan od dva načina:
  //   • lokalni razvoj → appsettings.Local.json (gitignore-ovan)
  //   • produkcija     → environment varijable, npr.
  //                      Jwt__Secret, ConnectionStrings__DefaultConnection,
  //                      Email__Password, Encryption__MessageKey, AdminSeed__Password
  // Program.cs na startu proverava da su sve popunjene i pada sa jasnom
  // porukom ako nisu (SecretsGuard).
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "usluzionica-api",
    "Audience": "usluzionica-app",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "noreply@usluzionica.rs"
  },
  "AdminSeed": {
    "Email": "admin@usluzionica.rs",
    "Password": ""
  },
  "Encryption": {
    "MessageKey": ""
  },

  // Service account kljuc iz Firebase konzole, kao JEDAN RED JSON-a.
  //
  // Prazno = push je iskljucen i koristi se NoopPushSender (vidi Program.cs),
  // pa razvoj i testovi rade bez Firebase naloga.
  //
  // U produkciji ide kroz Firebase__ServiceAccountJson iz .env. Kljuc je TAJNA
  // ravna lozinci - ko ga ima moze slati notifikacije svim korisnicima.
  "Firebase": {
    "ServiceAccountJson": ""
  },
  // Apple: push na iPhone (APNs) i Sign in with Apple — jedan .p8 ključ.
  // PrivateKey = base64 celog .p8 fajla. Prazno = oba isključena.
  // Apns:Production=false samo za build pokrenut iz Xcode-a (sandbox).
  "Apple": {
    "TeamId": "",
    "KeyId": "",
    "PrivateKey": "",
    "BundleId": "rs.usluzionica.app"
  },
  "Apns": {
    "Production": true
  },

  // Prijava preko Facebook-a i Google-a. Prazna tajna = provajder isključen,
  // dugme u aplikaciji vodi na poruku „nije podešeno".
  //
  // AppId i ClientId NISU tajne (vide se u adresi za prijavu). AppSecret i
  // ClientSecret JESU — idu isključivo kroz .env:
  //   Facebook__AppSecret, Google__ClientId, Google__ClientSecret
  "Facebook": {
    // ISKLJUČENO dok Meta ne pusti aplikaciju u Live (posle App Review-a).
    // U razvojnom režimu prijava radi samo za naloge sa ulogom u aplikaciji —
    // svi ostali bi dobili grešku. Uključuje se kroz .env: FACEBOOK_ENABLED=true
    "Enabled": false,
    "AppId": "1547889757366426",
    "AppSecret": "",
    "GraphVersion": "v24.0"
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },

  // ── Podešavanja koja nisu tajne ───────────────────────────────────────────
  "ExternalAuth": {
    // Kuda se aplikacija vraća posle prijave. Mora se poklapati sa
    // IntentFilter-om u UsluzionicaApp (WebAuthenticationCallbackActivity).
    "CallbackUri": "usluzionica://auth",

    // Kuda se vraća sajt (start sa client=web). Prazno = {App:SiteUrl}/app/oauth/povratak.
    "WebCallbackUri": ""
  },
  "App": {
    "BaseUrl": "https://localhost:7176",

    // Javni sajt — ono što ide ljudima van aplikacije (link pozivnice).
    // BaseUrl je API i služi za linkove koje otvara server (potvrda mejla, slike).
    "SiteUrl": "https://usluzionica.rs",

    // Linkovi na prodavnice — idu u mejl listi čekanja (Services/ListaCekanjaMejl.cs).
    // AppStoreUrl: PRAZNO dok se ne upiše pravi link iz App Store Connect-a
    // (App Information → „View on App Store"). Dok je prazno, pregled mejla
    // pokazuje upadljiv placeholder, a pravo slanje se odbija.
    // Env: App__AppStoreUrl / App__GooglePlayUrl (u .env: APP_STORE_URL, GOOGLE_PLAY_URL).
    "AppStoreUrl": "",
    "GooglePlayUrl": "https://play.google.com/store/apps/details?id=rs.usluzionica.app"
  },
  "Cors": {
    // Prazno = dozvoljen svaki origin (samo u Development-u).
    // U produkciji obavezno nabroj tačne origin-e.
    "AllowedOrigins": []
  },
  "Referral": {
    "SignupRewardTokens": 2.0,
    "ProviderActivationRewardTokens": 3.0
  },
  "Booking": {
    "ServiceRewardTokens": 5,
    "ProviderRewardTokens": 3,
    "ExecuteAfterDays": 7
  },
  // Bonus za listu čekanja sa sajta (Services/ListaCekanjaBonus.cs).
  // Path = prijave.jsonl sajta; prazno = bonus isključen (lokalno, testovi).
  // AndroidLaunchDate / IosLaunchDate = dan izlaska za tu platformu (UTC
  // datum, yyyy-MM-dd); prazno = još nije izašla. Svaka lista ima svoj rok
  // (ClaimDays). IosLaunchDate je ujedno DATUM IZLASKA NA iOS-u za ceo server
  // (env Waitlist__IosLaunchDate, u .env WAITLIST_IOS_LAUNCH_DATE): od njega
  // zavise bonus, tekst mejla listi čekanja i zaštita da se mejl ne pošalje
  // pre izlaska.
  //
  // Email = mejl „stigli smo na App Store" (Services/ListaCekanjaMejl.cs).
  // Šalje se u paketima od BatchSize, sa PauseSeconds pauze između paketa, i
  // najviše MaxPerRun po jednom pokretanju — da se ne pređe dnevni limit SMTP
  // provajdera (verifikacioni mejlovi troše isti limit!).
  "Waitlist": {
    "Path": "",
    "BonusTokens": 10,
    "AndroidLaunchDate": "",
    "IosLaunchDate": "",
    "ClaimDays": 60,
    "Email": {
      "BatchSize": 20,
      "PauseSeconds": 60,
      "MaxPerRun": 80
    }
  },
  "MessageRetentionDays": 14,

  // Demo podaci za snimke ekrana i promo video (Infrastructure/Demo/DemoSeed.cs).
  // NIKAD u produkciji — server tada odbija da se pokrene. Uključuje se samo
  // lokalno, u appsettings.Local.json, zajedno sa lozinkom za demo naloge.
  "DemoSeed": {
    "Enabled": false,
    "Password": "",
    // Folder sa fotografijama: ime fajla počinje ključem uslugodavca
    // (vodoinstalater-1.jpg, frizerka-1.jpg…). Prazno = oglasi bez slika.
    "ImagesPath": ""
  }
}
